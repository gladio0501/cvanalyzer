# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///cvanalyzer.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/cvanalyzer

# SQL Echo (set to 'true' for debugging)
SQL_ECHO=false

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_this_in_production
JWT_ACCESS_TOKEN_EXPIRES=86400  # 24 hours in seconds
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days in seconds

# OAuth Provider Configuration - Google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Flask Port (default: 5001, avoid 5000 due to macOS AirPlay)
FLASK_PORT=5001

# Admin Emails (comma-separated)
ADMIN_EMAILS=admin@example.com

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:5001

# Flask Configuration
FLASK_SECRET_KEY=your_flask_secret_key_here_change_this
FLASK_ENV=development

# Optional: LoRA API Configuration
LORA_API_URL=http://localhost:8080
